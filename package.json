{
  "name": "journs",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:push": "bun ./scripts/push-check.ts",
    "check:quests": "bun ./scripts/quest-check.ts",
    "check:auth": "bun ./scripts/auth-check.ts",
    "db:drop-all": "bun --preload ./scripts/bun-v8-patch.ts ./scripts/drop-all.ts",
    "db:purge-stale": "bun --preload ./scripts/bun-v8-patch.ts ./scripts/purge-stale-users.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "check:knip": "knip",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@scure/bip39": "^2.2.0",
    "@vercel/analytics": "^2.0.1",
    "animejs": "^4.5.0",
    "howler": "^2.2.4",
    "jose": "^6.2.4",
    "mermaid": "^11.16.0",
    "mongodb": "^7.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shepherd.js": "^15.2.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vercel": "^56.4.1",
    "vite": "^6.3.5"
  }
}
