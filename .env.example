MONGODB_URI=
MONGODB_DB=journs
JWT_SECRET=
CRON_SECRET=
# Web Push (VAPID). Generate once with: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Same value as VAPID_PUBLIC_KEY — the client needs it at build time
VITE_VAPID_PUBLIC_KEY=
# Optional: leave empty for same-origin /api (Vite in-process middleware or Vercel)
VITE_API_BASE=